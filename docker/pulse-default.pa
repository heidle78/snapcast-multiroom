# PulseAudio startup script for snapcast-multiroom container
# auth-anonymous=1 disables cookie auth so root can use pactl without
# being in the pulse-access group.

load-module module-native-protocol-unix auth-anonymous=1

# Disable channel remixing globally — prevents PulseAudio from upmixing
# stereo streams to all 8 channels of the surround DAC, which would cause
# all speakers to play simultaneously instead of only the routed ones.
load-module module-stream-restore
load-module module-rescue-streams

.nofail
load-module module-udev-detect tsched=0 remixing=no
.fail

load-module module-always-sink
